{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miftan-web",
  "compatibility_date": "2026-08-01",

  /**
   * A small Worker in front of the files, for two jobs: passing /api/* to the
   * API, so the app and the API share one origin, and writing the preview card
   * (og: tags) into public listing pages, which WhatsApp reads without running
   * any JavaScript. Every other path goes straight to the files.
   */
  "main": "./apps/web/worker/index.js",
  /**
   * API_URL (the API's address, e.g. the Cloud Run service URL) and the secret
   * PROXY_SECRET are set in the Cloudflare dashboard — Workers → miftan-web →
   * Settings → Variables and Secrets — not here. keep_vars stops each deploy
   * from wiping them, so moving the API never needs a commit or a rebuild.
   */
  "keep_vars": true,

  /**
   * Cloudflare ran `wrangler deploy` from the repository root and could not
   * work out which app in the workspace to ship. This file answers that: the
   * built web app, and nothing else.
   */
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    /* Only the API and the public listing pages reach the Worker. */
    "run_worker_first": ["/api/*", "/l/*"],
    /**
     * The app is a single-page app with client-side routing. Without this,
     * every deep link — /owner/properties, /search/prop_x — would 404 on a
     * cold load, because no such file exists on disk. This serves index.html
     * for unknown paths and lets the router decide.
     */
    "not_found_handling": "single-page-application"
  }
}
