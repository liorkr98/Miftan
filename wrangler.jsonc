{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miftan",
  /* Node's HTTP modules and a populated process.env come with nodejs_compat
     from this date on; the API (Fastify) needs both. */
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  /**
   * One Worker for the whole product: the built web app, the API under /api
   * (apps/api/src/worker.ts, run in-process), and the preview card written
   * into public listing pages, which WhatsApp reads without running any
   * JavaScript.
   */
  "main": "./apps/web/worker/index.js",
  /* The bundler would otherwise take pino's browser build, which lacks what
     Fastify's logger reads from it. */
  "alias": {
    "pino": "./node_modules/pino/pino.js"
  },

  /**
   * Optional settings and secrets (JWT_SECRET, RESEND_API_KEY, WEB_ORIGIN,
   * DEEPSEEK_API_KEY …) are set in the Cloudflare dashboard — Workers →
   * miftan → Settings → Variables and Secrets — never here. keep_vars stops
   * each deploy from wiping them. None is required to sign in.
   */
  "keep_vars": true,
  "vars": {
    "NODE_ENV": "production",
    /* This is the demo: an empty database is filled with the demo portfolio
       on first start (apps/api/src/db/demo-seed.ts), and the demo badge
       shows. Remove both before the first real user. */
    "DEMO_DATABASE": "true",
    "DEMO_MODE": "true"
  },

  /* The database. The Worker brings its schema up to date by itself on the
     first request after a deploy (apps/api/src/db/migrate.ts). */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miftan",
      "database_id": "a1fd7db5-0041-4a3a-a4ae-939a1ec190dd",
      "migrations_dir": "./apps/api/migrations"
    }
  ],

  /* Uploaded photos, receipts and contracts. Private: files are only ever
     read through the API's signed links. */
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "miftan-uploads"
    }
  ],

  /* D1 lives in one region (WEUR) and a page's API call makes many queries
     in a row. Run the Worker beside the database rather than beside the
     visitor; static assets are still served from the nearest edge. */
  "placement": { "mode": "smart" },

  "observability": { "enabled": true },

  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    /* Only the API and the public listing pages reach the Worker. */
    "run_worker_first": ["/api/*", "/l/*"],
    /**
     * The app is a single-page app with client-side routing. Without this,
     * every deep link — /owner/properties, /search/prop_x — would 404 on a
     * cold load, because no such file exists on disk. This serves index.html
     * for unknown paths and lets the router decide.
     */
    "not_found_handling": "single-page-application"
  }
}
