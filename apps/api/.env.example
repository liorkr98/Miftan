# Local development. Postgres.app defaults to your macOS username, no password.
#
# 127.0.0.1 rather than localhost: on macOS localhost resolves to ::1 first, and
# any mismatch between what the resolver returns and what Postgres is bound to
# shows up as a silent 30-second connect timeout rather than a refused
# connection. Naming the address removes the ambiguity.
DATABASE_URL=postgres://USER@127.0.0.1:5432/miftach_dev
NODE_ENV=development
PORT=4000
# 32+ chars. Rotating it signs everyone out.
JWT_SECRET=generate-with-openssl-rand-base64-48
WEB_ORIGIN=http://localhost:5178
