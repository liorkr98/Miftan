# Copy to apps/api/.env and fill in. Never commit the real file.

# Local development. Postgres.app defaults to your macOS username, no password.
DATABASE_URL=postgres://127.0.0.1:5432/miftan
NODE_ENV=development
# Set to true only for the demo database. Seed and reset refuse to run without it.
DEMO_DATABASE=

# Resend. Leave empty in development — mail is printed to the console.
# Never commit the real key. Production: a GitHub / Fly secret.
RESEND_API_KEY=
EMAIL_FROM=בעל הבית <noreply@baalabait.co.il>

# DeepSeek, for reading free-text search requests. Leave empty and the built-in
# rule parser answers instead. Server-side only — never commit the real key.
DEEPSEEK_API_KEY=
PORT=4000

# 32+ characters. Generate with: openssl rand -base64 48
JWT_SECRET=

WEB_ORIGIN=http://localhost:5178

# Behind the Vite dev proxy the browser sees /api/auth, not /auth.
COOKIE_PATH=/api/auth

# ── Object storage (Cloudflare R2) ─────────────────────────
# Optional locally: without these, uploads go to apps/api/uploads.
# Required in production — the API refuses to boot otherwise.
#
# These are R2 *S3 access keys*, created at
#   R2 → Manage R2 API Tokens → Create API token → Object Read & Write.
# A Cloudflare API token (cfut_…) is a different credential and will not work.
# Cloudflare R2:  https://<account>.r2.cloudflarestorage.com
# Supabase:       https://<ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_BUCKET=miftan-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 'auto' suits R2; Supabase wants the project region, e.g. eu-central-1
S3_REGION=auto
# The bucket's public read origin: a custom domain, or the r2.dev subdomain.
S3_PUBLIC_URL=
