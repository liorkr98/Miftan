{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@miftan/shared": ["../../packages/shared/src/index.ts"],
      "@miftan/fixtures": ["../../packages/fixtures/src/index.ts"]
    }
  },
  "include": ["src"]
}
