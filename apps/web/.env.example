# Copy to apps/web/.env.local for local overrides. Never commit the real file.

# There is no API address here. The app always calls /api on its own origin:
# the Vite dev proxy serves it locally, and the web Worker (API_URL in the
# Cloudflare dashboard) when deployed.

# true only for the demo Worker. Production builds leave this unset.
VITE_DEMO=
