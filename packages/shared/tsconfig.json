{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Empty on purpose. Nothing in this package may reach for a Node global:
       it has to run in Node, a browser and a Capacitor webview alike. The
       tests are checked separately, under tsconfig.test.json, because the
       purity check itself has to read files off disk. */
    "types": [],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
