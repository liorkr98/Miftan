# drizzle-orm declares optional peers on react-native / expo-sqlite (for its
# React Native driver, which we don't use). npm tries to resolve those against
# this workspace's React 18 and fails, which pushes drizzle-orm down into
# apps/api/node_modules where drizzle-kit — hoisted to the root — can't see it.
#
# Turning off strict peer resolution keeps the tree flat and the two packages
# as siblings. Revisit if we ever add a package with a peer conflict that
# actually matters.
legacy-peer-deps=true
